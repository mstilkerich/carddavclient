<?xml version="1.0"?>
<psalm
    errorLevel="1"
    phpVersion="8.2"
    ensureOverrideAttribute="false"
    sealAllProperties="false"
    resolveFromConfigFile="true"
    findUnusedVariablesAndParams="true"
    findUnusedPsalmSuppress="true"
    findUnusedCode="false"
    findUnusedBaselineEntry="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    >
<!--
    checkForThrowsInGlobalScope="true"
    findUnusedCode="true"
-->
    <projectFiles>
        <directory name="src/"/>
        <directory name="tests/"/>
        <file name="doc/quickstart.php"/>
        <ignoreFiles allowMissingFiles="true">
            <file name="tests/Interop/AccountData-*.php" />
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
    </plugins>

    <issueHandlers>
        <!-- Making the public classes final would be a BC break for users that extend them -->
        <ClassMustBeFinal errorLevel="suppress" />
        <!-- sabre/vobject 5 documents only some of the dynamic VCard properties with @property, which seals the others -->
        <UndefinedMagicPropertyFetch>
            <errorLevel type="suppress">
                <referencedProperty name="Sabre\VObject\Component\VCard::$FN" />
                <referencedProperty name="Sabre\VObject\Component\VCard::$NICKNAME" />
                <referencedProperty name="Sabre\VObject\Component\VCard::$NOTE" />
                <referencedProperty name="Sabre\VObject\Component\VCard::$UID" />
                <referencedProperty name="Sabre\VObject\Component\VCard::$VERSION" />
            </errorLevel>
        </UndefinedMagicPropertyFetch>
        <UndefinedMagicPropertyAssignment>
            <errorLevel type="suppress">
                <referencedProperty name="Sabre\VObject\Component\VCard::$FN" />
                <referencedProperty name="Sabre\VObject\Component\VCard::$NICKNAME" />
                <referencedProperty name="Sabre\VObject\Component\VCard::$NOTE" />
                <referencedProperty name="Sabre\VObject\Component\VCard::$UID" />
                <referencedProperty name="Sabre\VObject\Component\VCard::$VERSION" />
            </errorLevel>
        </UndefinedMagicPropertyAssignment>
        <UnevaluatedCode>
            <errorLevel type="suppress">
                <file name="doc/quickstart.php" />
            </errorLevel>
        </UnevaluatedCode>
        <!-- Converting a PSR-3 Stringable message calls an impure __toString(), which the psr/log stub does not allow.
             Annotating the sample logger with capabilities would only clutter the quickstart example. -->
        <ImmutableDependency>
            <errorLevel type="suppress">
                <file name="doc/quickstart.php" />
            </errorLevel>
        </ImmutableDependency>
        <!-- The quickstart is a CLI script, its output is not interpreted as HTML -->
        <TaintedHtml>
            <errorLevel type="suppress">
                <file name="doc/quickstart.php" />
            </errorLevel>
        </TaintedHtml>
        <TaintedTextWithQuotes>
            <errorLevel type="suppress">
                <file name="doc/quickstart.php" />
            </errorLevel>
        </TaintedTextWithQuotes>
        <!-- Requesting URIs reported by the server (e.g. Location header) is inherent to (Card)DAV. Credentials are
             only sent to the same origin as the base URI (see HttpClientAdapter::mayAuthenticate()). -->
        <TaintedSSRF>
            <errorLevel type="suppress">
                <file name="src/HttpClientAdapterGuzzle.php" />
            </errorLevel>
        </TaintedSSRF>
    </issueHandlers>
</psalm>
